# Playwright MCP
.playwright-mcp/

# Ignore log files in blog folder
blog/**/*.log

# Per-post editing workspaces (agent notes, never published)
blog/files/*/_editing/

# Blog build system
blog/_site/
blog/__pycache__/
blog/.build_cache.json

# Search engine
search/.cache/
search/__pycache__/
search/adapters/__pycache__/
search/node/node_modules/
search/node/.models/
search/worker/node_modules/
